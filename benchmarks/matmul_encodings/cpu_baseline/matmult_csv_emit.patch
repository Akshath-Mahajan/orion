 	}
 	fmt.Println()
+
+	errVal := -1.0
+	if verify {
+		errVal = maxErr
+	}
+	// BMM-III ops: ~m * stop ct*ct, ~m mask sites per LongRot pair.
+	// Plain shape spec is (n,m,p); the cipher kernel doesn't expose
+	// counted op tallies so we leave rotations / ct_pt as 0 in the
+	// CSV and surface the bookkeeping via the existing stdout report.
+	csvEmit("bmm3", fmt.Sprintf("(%d,%d,%d)", n, m, p),
+		nHE, len(elapseds), mean, stdev, 0, 0, 0, errVal)
 }
 
